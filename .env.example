# Copy to .env and adjust. .env is never committed.
#
# The starter runs with none of these set except the two under "Model access". Everything else is
# opt-in, because every service you have to stand up before the product runs is another way for
# somebody else's review of it to end early.

NODE_ENV=development
PORT=3000

# --- Model access ------------------------------------------------------------------------------
#
# LLM_PROVIDER picks how the agent talks to a model:
#
#   responses  OpenAI's Responses API. The default. The only one with hosted tools — web_search
#              and file_search — so it can search the web or a set of uploaded documents with no
#              retrieval code, no vector database and no embedding pipeline of ours.
#   chat       Chat Completions. The portable dialect: NVIDIA NIM, Groq, Together, vLLM and
#              OpenAI all speak it. Switch here when credits run out or one endpoint is saturated.
#   mock       A scripted agent that calls the real tools with no key and no network. This is how
#              the product is demonstrated on dead wifi, and how somebody verifies the main
#              scenario without being handed anybody's API key.
#
# Endpoints, for reference:
#   OpenAI   leave LLM_BASE_URL empty                        gpt-6-luna
#   NVIDIA   https://integrate.api.nvidia.com/v1             (see the NIM catalogue)
#   Groq     https://api.groq.com/openai/v1                  openai/gpt-oss-120b
#
# Hosted tools are OpenAI's. Pointing LLM_BASE_URL elsewhere means LLM_PROVIDER=chat.

# This file ships with `mock` on purpose, so that copying it and starting the application gives a
# working product with no credentials at all. That is the path a reviewer takes, and it should not
# end in an error message about a key they were never given.
#
# For a live model, use OpenAI Responses:
#   LLM_PROVIDER=responses
#   LLM_MODEL=gpt-6-luna
#   LLM_API_KEY=<a real key>
#
# Embeddings use OpenAI's text-embedding-3-small.
LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_MODEL=gpt-6-luna

# Never commit a real key.
LLM_API_KEY=

# --- Hosted tools (Responses adapter only) -------------------------------------------------------
#
# Create a vector store with:  pnpm tsx scripts/upload-files.ts ./path/to/documents
# Then paste the id it prints here and the agent gains a file_search tool automatically.

OPENAI_VECTOR_STORE_ID=
OPENAI_WEB_SEARCH=false
