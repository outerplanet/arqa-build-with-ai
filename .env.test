# Loaded by vitest before .env, and dotenv never overwrites a variable that is already set — so
# this wins over a developer's .env and keeps the suite off a real provider.
#
# The scripted adapter is the only one that can run without a network or a key, which is exactly
# what a test needs. Committed on purpose: it contains no secrets and never should.

NODE_ENV=test
LLM_PROVIDER=mock
