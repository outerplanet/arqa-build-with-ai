{
	"name": "agent-starter",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"build": "next build",
		"check": "node scripts/check.mjs",
		"db:down": "docker compose down",
		"db:logs": "docker compose logs -f db",
		"db:migrate": "prisma migrate dev",
		"db:psql": "docker compose exec db psql -U app_user -d app",
		"db:reset": "docker compose down -v && docker compose up -d --wait",
		"db:seed": "prisma db seed",
		"db:up": "docker compose up -d --wait",
		"dev": "next dev",
		"format": "prettier --write .",
		"format:affected": "pretty-quick",
		"format:staged": "pretty-quick --staged",
		"lint": "eslint . --ext .ts,.tsx --max-warnings 0 --cache --cache-location .cache/eslint/ --cache-strategy content",
		"lint:fix": "eslint . --ext .ts,.tsx --max-warnings 0 --cache --cache-location .cache/eslint/ --cache-strategy content --fix",
		"lint:no-cache": "eslint . --ext .ts,.tsx --max-warnings 0 --no-cache",
		"postinstall": "prisma generate",
		"start": "next start",
		"test": "vitest run --project unit",
		"test:all": "vitest run",
		"test:integration": "vitest run --project integration",
		"test:unit": "vitest run --project unit",
		"test:watch": "vitest",
		"typecheck": "node node_modules/typescript7/bin/tsc --noEmit",
		"typecheck:legacy": "tsc --noEmit",
		"verify": "pnpm typecheck && pnpm lint",
		"verify:fix": "pnpm typecheck && pnpm lint:fix"
	},
	"dependencies": {
		"@heroicons/react": "^2.2.0",
		"@hookform/resolvers": "^5.9.1",
		"@prisma/adapter-pg": "7.10.0",
		"@prisma/client": "7.10.0",
		"clsx": "^2.1.1",
		"date-fns": "^4.4.0",
		"dotenv": "^17.4.2",
		"next": "^16.3.4",
		"openai": "^7.18.0",
		"radix-ui": "^1.6.7",
		"react": "19.1.1",
		"react-dom": "19.1.1",
		"react-hook-form": "^7.88.0",
		"server-only": "^0.0.1",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.3.5",
		"@eslint/js": "^9.39.4",
		"@tailwindcss/postcss": "4.1.13",
		"@types/node": "22.15.3",
		"@types/pg": "^8.23.1",
		"@types/react": "19.1.9",
		"@types/react-dom": "19.1.7",
		"eslint": "^9.39.4",
		"eslint-config-airbnb": "^19.0.4",
		"eslint-config-prettier": "^10.1.8",
		"eslint-import-resolver-typescript": "^4.4.5",
		"eslint-plugin-boundaries": "^6.0.2",
		"eslint-plugin-check-file": "^3.3.1",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"eslint-plugin-perfectionist": "^5.9.0",
		"eslint-plugin-prettier": "^5.5.6",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.2",
		"eslint-plugin-sort-react-dependency-arrays": "^1.0.0",
		"globals": "^17.6.0",
		"pg": "^8.23.0",
		"postcss": "8.5.6",
		"prettier": "^3.9.6",
		"prettier-plugin-css-order": "^2.2.0",
		"prettier-plugin-organize-imports": "^4.3.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"pretty-quick": "^4.2.2",
		"prisma": "7.10.0",
		"tailwindcss": "4.1.13",
		"tsx": "^4.23.13",
		"typescript": "6.0.3",
		"typescript-eslint": "^8.60.1",
		"typescript7": "npm:typescript@^7.0.2",
		"vitest": "^5.0.0"
	},
	"packageManager": "pnpm@10.28.2",
	"pnpm": {
		"onlyBuiltDependencies": [
			"@tailwindcss/oxide",
			"sharp",
			"unrs-resolver"
		]
	}
}
