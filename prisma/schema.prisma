// Starter data model.
//
// One table, and it is not precious: it exists so that `prisma migrate dev`, the seed and the
// integration harness have something to run against. Replace it with the real domain.
//
// Conventions worth keeping as it grows:
//
//   - snake_case in the database, camelCase in the client, mapped explicitly with `@map`.
//     The database is read by humans with psql; the client is read by TypeScript.
//   - `uuid(7)` rather than autoincrement. A v7 id sorts by creation time, so it indexes like
//     a sequence without telling the world how many rows exist.
//   - Timestamps are `Timestamptz(3)`. Every stored instant is UTC; a timezone is a display
//     concern and belongs to the user, not to the column.

generator client {
  provider     = "prisma-client"
  output       = "../src/server/db/generated"
  moduleFormat = "esm"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum EntityStatus {
  active
  archived

  @@map("entity_status")
}

model User {
  id        String       @id @default(uuid(7)) @db.Uuid
  email     String       @unique
  name      String
  status    EntityStatus @default(active)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("users")
}
