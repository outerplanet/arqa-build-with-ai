# dependencies
node_modules/
.venv*/
__pycache__/
.pytest_cache/

# build output
.next/
out/
next-env.d.ts
*.tsbuildinfo

# test output
coverage/

# caches
.cache/

# logs
*.log
logs/

# environment and secrets
.env*
!.env*.example
# Committed on purpose: it pins the test suite to the scripted provider. Nothing that is
# actually secret belongs in it.
!.env.test
*.pem

# lock files from other package managers
package-lock.json
yarn.lock

# editors
.vscode/*
!.vscode/extensions.json
.idea/
*.sw?
.DS_Store

# agent harness — shared config is committed, per-developer overrides are not
.claude/settings.local.json
# Marker written by `pnpm gate:unlock`. Its presence disables the protectGate hook, so it
# must never be committed — a checked-in marker would silently unlock every clone.
.claude/.gate-unlocked
# Subagent worktrees: whole checkouts of this repository. Remove them after merging
# (`git worktree remove`); ESLint still scans them while they exist.
.claude/worktrees/
