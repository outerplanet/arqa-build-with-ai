# dependencies
node_modules/

# build output
.next/
out/
next-env.d.ts
*.tsbuildinfo

# test output
coverage/

# caches
.cache/

# logs
*.log
logs/

# Prisma client, regenerated by postinstall and by every migration. Committing it means
# reviewing a few thousand generated lines on every schema change.
src/server/db/generated/

# environment and secrets
.env*
!.env*.example
# Committed on purpose: it holds only the localhost connection string for the throwaway
# test database. Without it a fresh clone cannot run the integration tests. Nothing that
# is actually secret belongs in it.
!.env.test
*.pem

# lock files from other package managers
package-lock.json
yarn.lock

# editors
.vscode/*
!.vscode/extensions.json
.idea/
*.sw?
.DS_Store

# agent harness — shared config is committed, per-developer overrides are not
.claude/settings.local.json
# Marker written by `pnpm gate:unlock`. Its presence disables the protectGate hook, so it
# must never be committed — a checked-in marker would silently unlock every clone.
.claude/.gate-unlocked
